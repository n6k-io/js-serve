{
  "name": "@n6k.io/serve",
  "version": "0.1.1",
  "private": false,
  "description": "Serve a single .mdx page with live data from n6kd or pykit",
  "repository": "https://github.com/n6k-io/js-serve",
  "license": "MIT",
  "type": "module",
  "files": [
    "src"
  ],
  "bin": {
    "n6k-serve": "src/cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "fmt": "prettier --write --log-level=warn .",
    "check": "bun run fmt && bun run lint --fix && bun run typecheck",
    "fmt:check": "prettier --check .",
    "ci": "bun run fmt:check && bun run lint && bun run typecheck && bun test"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev114.0",
    "@n6k.io/build": "^0.5.1",
    "@n6k.io/db": "^0.13.1",
    "@n6k.io/runtime": "^0.1.2",
    "@n6k.io/ui": "^0.10.2",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.104.1",
    "esbuild": "^0.28.2",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.4.1",
    "eslint-plugin-unicorn": "^65.0.1",
    "prettier": "^3.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.61.0"
  }
}
